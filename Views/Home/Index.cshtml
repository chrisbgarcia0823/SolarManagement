@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/AdminLTE/_UserLayout.cshtml";
}

@section Styles 
{

    @*FOR ALERTS*@
    <link href="~/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/plugins/toastr/toastr.min.css" rel="stylesheet" />

    @*FOR DATATABLE*@
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}


<div class="row mt-5">
    <div class="col">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="far fa-chart-bar"></i> Critical Load Power Monitoring</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"><div class=""></div></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                <canvas id="LineChart-LoadPowerEsp1" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%; display: block; width: 1084px;" width="1084" height="250" class="chartjs-render-monitor"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="far fa-chart-bar"></i> Critical Voltage Monitoring</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"><div class=""></div></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                <canvas id="LineChart-LoadVoltageEsp1" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%; display: block; width: 1084px;" width="1084" height="250" class="chartjs-render-monitor"></canvas>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script src="~/plugins/flot/jquery.flot.js"></script>

    <script src="~/plugins/flot/plugins/jquery.flot.resize.js"></script>

    <script src="~/plugins/flot/plugins/jquery.flot.pie.js"></script>

    @*FOR ALERTS*@
    <script src="~/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/plugins/toastr/toastr.min.js"></script>

    @*FOR CHART JS*@
    <script src="~/plugins/chart.js/Chart.min.js"></script>

    @*ITEMS BELOW SAFETY STOCKS*@
    <script>
        $(async function () {
            //FOR ALERT
            var Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000
            });
            
            //URL ACTION OF THE METHOD TO ACCESS
            const apiUrl = `@Url.Action("LoadPowerData", "Home")/1`;
            // Get the information of the selected item from the controller
            const Data = await fetch(apiUrl);
            let date = [];
            let power = [];
            let voltage = [];

            if(Data.status === 200) //status success
            {
                const jsonData = await Data.json();
                //console.log(jsonData);
                //get the labels (equivalent to the item number)
                for(i=0; i < jsonData.length; i++)
                {
                    date.push(jsonData[i].datetimecreated.toString()); //adding new data to array
                    power.push(jsonData[i].power); //adding new data to array
                    voltage.push(jsonData[i].volt);
                };
            }
            else
            {
                toastr.error("Error Loading Esp1 data error");
            }

            //-------------
            //- LINE CHART - POWER DATA
            //-------------


            // Get context with jQuery - using jQuery's .get() method.
            var lineChartPowerESP1 = $('#LineChart-LoadPowerEsp1').get(0).getContext('2d')

            //generate the chart
            var lineChartDataPowerEsp1 = {
                labels: date,
                datasets: [
                    {
                        label: 'Power Data', //THIS WILL BE THE SHOWN WHEN HOVER (EXAPLE: Power Data: 2)
                        data: power, //THIS WILL BE THE DATA ON THE PLOT
                        fill: false,
                        borderColor: 'rgb(75, 192, 192)',
                        tension: 0.1
                    },
                ]
            }

            new Chart(lineChartPowerESP1, {
                type: 'line',
                data: lineChartDataPowerEsp1,
            });


            //-------------
            //- LINE CHART - VOLTAGE DATA
            //-------------


            // Get context with jQuery - using jQuery's .get() method.
            var lineChartVoltageESP1 = $('#LineChart-LoadVoltageEsp1').get(0).getContext('2d')

            //generate the chart
            var lineChartDataVoltageEsp1 = {
                labels: date,
                datasets: [
                    {
                        label: 'Voltage Data', //THIS WILL BE THE SHOWN WHEN HOVER (EXAPLE: Power Data: 2)
                        data: power, //THIS WILL BE THE DATA ON THE PLOT
                        fill: false,
                        borderColor: 'rgb(210, 52, 46)',
                        tension: 0.1
                    },
                ]
            }

            new Chart(lineChartVoltageESP1, {
                type: 'line',
                data: lineChartDataVoltageEsp1,
            });


        });



    </script>

    @*FOR DATATABLE*@
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/plugins/jszip/jszip.min.js"></script>
    <script src="~/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script>
        $(function () {
            $("#expiration").DataTable({
                "order": [[0, 'desc']],
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "paging": false,
                "info": true,
                "paging": true,
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
            }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
        });
    </script>

}
﻿@{
    ViewData["Title"] = "Battery Monitoring";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@section Styles
    {

    @*FOR ALERTS*@
    <link href="~/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/plugins/toastr/toastr.min.css" rel="stylesheet" />

}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title"><i class="far fa-chart-bar"></i>Battery Voltage Monitoring</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart" id="VoltageDiv">
            <canvas id="BarChart-Voltages" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
        </div>
    </div>
</div>

<div class="card card-success">
    <div class="card-header">
        <h3 class="card-title"><i class="far fa-chart-bar"></i>Battery Temperature Monitoring</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart" id="TemperatureDiv">
            <canvas id="BarChart-Temperature" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
        </div>
    </div>
</div>


@*MODAL FOR LIVE VIEW*@
<div class="modal" id="barModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="Title"></h5>
                <button type="button" class="close" data-dismiss="modal" id="ModalCloseBtn">&times;</button>
            </div>
            <div class="modal-body">
                <p id="modal-content"></p>
                <div class="row" id="LiveData_Div">
                    @*LIVE DATA FROM FETCH API WILL GO HERE*@
                    <canvas id="LiveData-Voltages" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>

                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" id="ModalCloseBtn">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(async function () {

            //FOR ALERT
            var Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000
            });

            //FOR BATTERY VOLATAGES AND CURRENT MONITORING ---------------------------------------------------------------------------------
            let batteryVoltages = [];
            let batteryTemperature = [];
            let batterNumber = [];
            let batteryDate = [];
            let currentTime = []; //convert to current date and get time
            let updateTime = 1 * 1000; //1seconds
            let isRealTime = false;
            let modalCloseBtn = document.getElementById('ModalCloseBtn')


            const apiUrl = `@Url.Action("GetBatteryData", "Home")`;
            const Data = await fetch(apiUrl);
            if (Data.status === 200) //status success
            {
                const result = await Data.json();
                //iterate to get the result
                for (i = 0; i < result.length; i++) {
                    batteryVoltages.push(result[i].voltage);
                    batteryTemperature.push(result[i].temperature);
                    currentTime.push(result[i].timeData.toString());
                    batterNumber.push(result[i].batterNumber)
                };
            }
            else {
                toastr.error("Error fetching data");
            }


            //-------------
            //- BAR CHART - VOLTAGES DATA
            //-------------


            // Get context with jQuery - using jQuery's .get() method.
            var barChartCanvas_Voltage = $('#BarChart-Voltages').get(0).getContext('2d'); //this will be my chart

            const ChartData_Voltage = {
                labels: batterNumber,
                datasets: [{
                    label: 'Battery Voltages',
                    data: batteryVoltages,
                    backgroundColor: 'rgba(51, 51, 225, 0.5)',
                }]
            };

            var ChartOptions_Voltage = {
                responsive: true,
                maintainAspectRatio: false,
                datasetFill: false,
                scales: {
                    xAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 16
                        },
                        display: true,
                        scaleLabel: {
                            display: true,
                            labelString: 'Battery Number',
                        },
                    }],
                    yAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 4
                        },
                        display: true,
                        scaleLabel:
                        {
                            display: true,
                            labelString: 'Volts',
                        },
                    }]
                },
            }

            const myChart_Voltage = new Chart(barChartCanvas_Voltage,
                {
                    type: 'bar',
                    data: ChartData_Voltage,
                    options: ChartOptions_Voltage
                })

            //-------------
            //- BAR CHART - TEMPERATURE DATA
            //-------------

            // Get context with jQuery - using jQuery's .get() method.
            var barChartCanvas_Temperature = $('#BarChart-Temperature').get(0).getContext('2d'); //this will be my chart

            const ChartData_Temperature = {
                labels: batterNumber,
                datasets: [{
                    label: 'Battery Temperature',
                    data: batteryTemperature,
                    backgroundColor: 'rgba(0, 204, 0, 0.5)',
                }]
            };

            var ChartOptions_Temperature = {
                responsive: true,
                maintainAspectRatio: false,
                datasetFill: false,
                scales: {
                    xAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 16
                        },
                        display: true,
                        scaleLabel: {
                            display: true,
                            labelString: 'Battery Number',
                        },
                    }],
                    yAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 50
                        },
                        display: true,
                        scaleLabel:
                        {
                            display: true,
                            labelString: 'Celcius',
                        },
                    }]
                },
            }

            const myChart_Temperature = new Chart(barChartCanvas_Temperature,
                {
                    type: 'bar',
                    data: ChartData_Temperature,
                    options: ChartOptions_Temperature
                })


            //GET NEW DATA ---------------------------------------------------------------------------------------

            async function getNewData() {
                //clear the previous values
                batteryVoltages = [];
                batteryTemperature = [];

                //URL ACTION OF THE METHOD TO ACCESS
                const apiUrl = `@Url.Action("GetBatteryData", "Home")`;
                // Get the information of the selected item from the controller
                const Data = await fetch(apiUrl);
                if (Data.status === 200) //status success
                {
                    const result = await Data.json();
                    for (i = 0; i < result.length; i++) {
                        batteryVoltages.push(result[i].voltage);
                        batteryTemperature.push(result[i].temperature);
                        currentTime.push(result[i].timeData.toString());
                        batterNumber.push(result[i].batterNumber)
                    };

                }
                else {
                    toastr.error("Error fectching data");
                }
            }

            // get new data every updateTime(as set above) and update chart
            setInterval(async function () {
                await getNewData();
                myChart_Voltage.data.datasets[0].data = batteryVoltages;
                myChart_Temperature.data.datasets[0].data = batteryTemperature;
                myChart_Voltage.update();
                myChart_Temperature.update();
                console.log('Voltage and Temperature Bar Chart Data Updated');
            }, updateTime);


            //END UPDATING THE CHART --------------------------------------------------------------------------------------------------


            //FOR CLICK AND OPEN MODAL ---------------------------------------------------------------------------------------------------------------
            //for modal


            // Event listener for chart click events for voltage
            barChartCanvas_Voltage.canvas.addEventListener('click', async (event) => {
                const clickedElements = myChart_Voltage.getElementsAtEvent(event);
                if (clickedElements.length > 0) {
                    const element = clickedElements[0]; // Get the first clicked element
                    const labelIndex = element._index; // Index of the clicked bar
                    const batteryNum = batterNumber[labelIndex];

                    window.location.href = `@Url.Action("LiveData")/${batteryNum}/Voltage`;
                }
            });

            // Event listener for chart click events for temperature
            barChartCanvas_Temperature.canvas.addEventListener('click', async (event) => {
                const clickedElements = myChart_Temperature.getElementsAtEvent(event);
                if (clickedElements.length > 0) {
                    const element = clickedElements[0]; // Get the first clicked element
                    const labelIndex = element._index; // Index of the clicked bar
                    const batteryNum = batterNumber[labelIndex];

                    window.location.href = `@Url.Action("LiveData")/${batteryNum}/Temperature`;
                }
            });

            //END OF BATTERY VOLTAGES AND CURRENT MONITORING -------------------------------------------------------------------------------

        });
    </script>


    @*FOR ALERTS*@
    <script src="~/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/plugins/toastr/toastr.min.js"></script>

    @*FOR CHART JS*@
    <script src="~/plugins/chart.js/Chart.min.js"></script>


}
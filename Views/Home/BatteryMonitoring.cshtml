@{
    ViewData["Title"] = "Battery Monitoring";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@section Styles
    {

    @*FOR ALERTS*@
    <link href="~/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/plugins/toastr/toastr.min.css" rel="stylesheet" />

    @*FOR DATATABLE*@
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title"><i class="far fa-chart-bar"></i>Battery Voltage Monitoring</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart" id="VoltageDiv">
            <canvas id="BarChart-Voltages" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
        </div>
    </div>
</div>

<div class="card card-success">
    <div class="card-header">
        <h3 class="card-title"><i class="far fa-chart-bar"></i>Battery Temperature Monitoring</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart" id="TemperatureDiv">
            <canvas id="BarChart-Temperature" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
        </div>
    </div>
</div>


@*MODAL FOR LIVE VIEW*@
<div class="modal" id="barModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="Title"></h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p id="modal-content"></p>
                <div class="row" id="LiveData_Div">
                    @*LIVE DATA FROM FETCH API WILL GO HERE*@
                    <canvas id="LiveData-Voltages" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>

                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(async function () {

            //FOR ALERT
            var Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000
            });

            //FOR BATTERY VOLATAGES AND CURRENT MONITORING ---------------------------------------------------------------------------------
            let batteryVoltages = [];
            let batteryTemperature = [];
            let batterNumber = [];
            let batteryDate = [];
            let currentTime = []; //convert to current date and get time
            let updateTime = 30 * 1000; //1seconds


            const apiUrl = `@Url.Action("GetBatteryData", "Home")`;
            const Data = await fetch(apiUrl);
            if (Data.status === 200) //status success
            {
                const result = await Data.json();
                //iterate to get the result
                for (i = 0; i < result.length; i++) {
                    batteryVoltages.push(result[i].voltage);
                    batteryTemperature.push(result[i].temperature);
                    currentTime.push(result[i].timeData.toString());
                    batterNumber.push(result[i].batterNumber)
                };
            }
            else {
                toastr.error("Error fetching data");
            }


            //-------------
            //- BAR CHART - VOLTAGES DATA
            //-------------


            // Get context with jQuery - using jQuery's .get() method.
            var barChartCanvas_Voltage = $('#BarChart-Voltages').get(0).getContext('2d'); //this will be my chart

            const ChartData_Voltage = {
                labels: batterNumber,
                datasets: [{
                    label: 'Battery Voltages',
                    data: batteryVoltages,
                    backgroundColor: 'rgba(51, 51, 225, 0.5)',
                }]
            };

            var ChartOptions_Voltage = {
                responsive: true,
                maintainAspectRatio: false,
                datasetFill: false,
                scales: {
                    xAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 16
                        },
                        display: true,
                        scaleLabel: {
                            display: true,
                            labelString: 'Battery Number',
                        },
                    }],
                    yAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 4
                        },
                        display: true,
                        scaleLabel:
                        {
                            display: true,
                            labelString: 'Volts',
                        },
                    }]
                },
            }

            const myChart_Voltage = new Chart(barChartCanvas_Voltage,
                {
                    type: 'bar',
                    data: ChartData_Voltage,
                    options: ChartOptions_Voltage
                })

            //-------------
            //- BAR CHART - TEMPERATURE DATA
            //-------------

            // Get context with jQuery - using jQuery's .get() method.
            var barChartCanvas_Temperature = $('#BarChart-Temperature').get(0).getContext('2d'); //this will be my chart

            const ChartData_Temperature = {
                labels: batterNumber,
                datasets: [{
                    label: 'Battery Temperature',
                    data: batteryTemperature,
                    backgroundColor: 'rgba(0, 204, 0, 0.5)',
                }]
            };

            var ChartOptions_Temperature = {
                responsive: true,
                maintainAspectRatio: false,
                datasetFill: false,
                scales: {
                    xAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 16
                        },
                        display: true,
                        scaleLabel: {
                            display: true,
                            labelString: 'Battery Number',
                        },
                    }],
                    yAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 50
                        },
                        display: true,
                        scaleLabel:
                        {
                            display: true,
                            labelString: 'Celcius',
                        },
                    }]
                },
            }

            const myChart_Temperature = new Chart(barChartCanvas_Temperature,
                {
                    type: 'bar',
                    data: ChartData_Temperature,
                    options: ChartOptions_Temperature
                })


             //GET NEW DATA ---------------------------------------------------------------------------------------

            async function getNewData() 
            {
                //clear the previous values
                batteryVoltages = [];
                batteryTemperature = [];

                //URL ACTION OF THE METHOD TO ACCESS
                const apiUrl = `@Url.Action("GetBatteryData", "Home")`;
                // Get the information of the selected item from the controller
                const Data = await fetch(apiUrl);
                if (Data.status === 200) //status success
                {
                    const result = await Data.json();
                    for (i = 0; i < result.length; i++) {
                        batteryVoltages.push(result[i].voltage);
                        batteryTemperature.push(result[i].temperature);
                        currentTime.push(result[i].timeData.toString());
                        batterNumber.push(result[i].batterNumber)
                    };

                }
                else {
                    toastr.error("Error fectching data");
                }
            }

            // get new data every updateTime(as set above) and update chart
            setInterval(async function () {
                await getNewData();
                myChart_Voltage.data.datasets[0].data = batteryVoltages;
                myChart_Temperature.data.datasets[0].data = batteryTemperature;
                myChart_Voltage.update();
                myChart_Temperature.update();
                console.log('Bar Chart Updated')
            }, updateTime);

            //END UPDATING THE CHART --------------------------------------------------------------------------------------------------


            //FOR CLICK AND OPEN MODAL ---------------------------------------------------------------------------------------------------------------
            //for modal
            const modalContent = document.getElementById('modal-content');
            const barModal = new bootstrap.Modal(document.getElementById('barModal')); // Assuming Bootstrap 5
            const title = document.getElementById('Title');

            // Event listener for chart click events
            barChartCanvas_Voltage.canvas.addEventListener('click', (event) => {
                const clickedElements = myChart_Voltage.getElementsAtEvent(event);

                if (clickedElements.length > 0) {
                    const element = clickedElements[0]; // Get the first clicked element

                    const labelIndex = element._index; // Index of the clicked bar
                    const batteryNumber = batterNumber[labelIndex];
                    const voltage = batteryVoltages[labelIndex];

                    // Update modal content
                    //modalContent.textContent = `You clicked on "${batteryNumber}" with a value of ${voltage}`;
                    title.textContent = `Batter ${batteryNumber} Live Voltage Data`;
                    GetLiveVoltageData(batteryNumber);

                    // Show the modal (assuming Bootstrap 5)
                    barModal.show();
                }
            });

            //END OF BATTERY VOLTAGES AND CURRENT MONITORING -------------------------------------------------------------------------------

        });
    </script>

    @*FETCHING THE DATA OF THE BATTERY VOLTAGE (FOR DISPLAYING THE LIVE DATA WHEN BAR IS CLICKED IN THE CHART)*@
    <script>
        async function GetLiveVoltageData(batteryNumber) {
            //FOR ALERT
            var Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000
            });

            //FOR BATTERY VOLATAGES AND CURRENT MONITORING ---------------------------------------------------------------------------------
            let batteryVoltage = [];
            let time = [];
            let updateTime = 1 * 10000; //1seconds


            const apiUrl = `@Url.Action("GetBatteryData", "Home")/${batteryNumber}`;
            const Data = await fetch(apiUrl);
            if (Data.status === 200) //status success
            {
                const result = await Data.json();
                //iterate to get the result
                for (i = 0; i < result.length; i++) {
                    batteryVoltage.push(result[i].voltage);
                    time.push(result[i].timeData.toString());
                };
            }
            else {
                toastr.error("Fetch data error");
            }


            //-------------
            //- LINE CHART - VOLTAGES DATA
            //-------------


            // Get context with jQuery - using jQuery's .get() method.
            var lineChartCanvas = $('#LiveData-Voltages').get(0).getContext('2d'); //this will be my chart

            const ChartData = {
                labels: time,
                datasets: [{
                    label: 'Live Battery Voltage Data',
                    data: batteryVoltage,
                    borderColor: 'rgb(75, 192, 192)',
                    tension: 0.1
                }]
            };

            var ChartOptions = {
                responsive: true,
                maintainAspectRatio: false,
                datasetFill: false,
                legend: {
                    display: true
                },
                scales: {
                    xAxes: [{
                        gridLines: {
                            display: true,
                        },
                        max: 60,
                    }],
                    yAxes: [{
                        gridLines: {
                            display: true,
                        }
                    }]
                },
                fill: false
            }

            const myChart = new Chart(lineChartCanvas,
                {
                    type: 'line',
                    data: ChartData,
                    options: ChartOptions
                })
            

            //FOR UPDATING THE CHART --------------------------------------------------------------------------------------------------
            async function getNewData() {
                //URL ACTION OF THE METHOD TO ACCESS
                const apiUrl2 = `@Url.Action("LoadNewBatteryData", "Home")/${batteryNumber}/update`;
                // Get the information of the selected item from the controller
                const Data2 = await fetch(apiUrl2);
                if (Data2.status === 200) //status success
                {
                    const result2 = await Data2.json();
                    if (time.at(-1) != result2.timeData.toString()) {
                        batteryVoltage.shift(); //remove the first element of the voltage data
                        time.shift(); //remove the first element of the time data

                        //insert the fetch data to the last element
                        batteryVoltage.push(result2.voltage);
                        time.push(result2.timeData.toString())
                    }

                }
                else {
                    toastr.error("Fetch data error");
                }
            }

            // get new data every updateTime(as set above) and update chart
            setInterval(async function () {
                getNewData();
                myChart.update();
                console.log('Line Chart Updated')
            }, updateTime);

            //END UPDATING THE CHART --------------------------------------------------------------------------------------------------
        };

    </script>

    @*FOR ALERTS*@
    <script src="~/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/plugins/toastr/toastr.min.js"></script>

    @*FOR CHART JS*@
    <script src="~/plugins/chart.js/Chart.min.js"></script>


}
@{
    ViewData["Title"] = "Live Data";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@section Styles
{
    @*FOR ALERTS*@
    <link href="~/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/plugins/toastr/toastr.min.css" rel="stylesheet" />

}


<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title" id="Card-Title"><i class="far fa-chart-bar"></i> Live Data Of Battery @TempData["BatteryNumber"] @TempData["Parameter"]</h3>
    </div>
    <div class="card-body">
        <div class="row" id="LiveData_Div">
            @*LIVE DATA FROM FETCH API WILL GO HERE*@
            <canvas id="LiveData-Voltages" style="min-height: 250px; height: 400px; max-height: 400px; max-width: 100%;"></canvas>
        </div>
    </div>
</div>


@section Scripts
{
    @*FOR BATTERY VOLTAGE*@
    @if (TempData["Parameter"].ToString().ToLower() == "voltage")
    {
        @*FETCHING THE DATA OF THE BATTERY VOLTAGE*@
        <script>
            $(async function () {

                let batteryNumber = @TempData["BatteryNumber"];

                //FOR ALERT
                var Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2000
                });

                //FOR BATTERY VOLATAGES DATA ---------------------------------------------------------------------------------
                let batteryVoltage = [];
                let timeData = [];
                let updateTime = 1 * 1000; //1seconds

                //FOR THE NEW REQUEST X-AXIS OF NOT TIME BASE BUT COUNT FROM 1 - 60
                let new_timeData = Array.from({ length: 60 }, (_, i) => i + 1);


                const apiUrl = `@Url.Action("GetBatteryData", "Home")/${batteryNumber}`;
                const Data = await fetch(apiUrl);
                if (Data.status === 200) //status success
                {
                    const result = await Data.json();
                    //iterate to get the result
                    for (i = 0; i < result.length; i++) {
                        batteryVoltage.push(result[i].voltage);
                        timeData.push(result[i].timeData.toString());
                    };
                }
                else {
                    toastr.error("Fetch data error");
                }

                //-------------
                //- LINE CHART - VOLTAGES DATA
                //-------------


                // Get context with jQuery - using jQuery's .get() method.
                var lineChartCanvas = $('#LiveData-Voltages').get(0).getContext('2d'); //this will be my chart

                const ChartData = {
                    labels: timeData,
                    datasets: [{
                        label: 'Live Battery Voltage Data',
                        data: batteryVoltage,
                        borderColor: 'rgb(75, 192, 192)',
                        tension: 0.1
                    }]
                };

                var ChartOptions = {
                    responsive: true,
                    maintainAspectRatio: false,
                    datasetFill: false,
                    legend: {
                        display: true
                    },
                    scales: {
                        xAxes: [{
                            gridLines: {
                                display: true,
                            },
                            max: 60,
                            scaleLabel: {
                                display: true,
                                labelString: 'Date-Time',
                            },
                        }],
                        yAxes: [{
                            gridLines: {
                                display: true,
                            },
                            ticks: { min: 0, max: 5, stepSize: 0.2, }
                        }]
                    },
                    fill: false
                }

                const myChart = new Chart(lineChartCanvas,
                    {
                        type: 'line',
                        data: ChartData,
                        options: ChartOptions
                    });

                //FOR UPDATING THE CHART --------------------------------------------------------------------------------------------------
                async function getNewData() {
                    //URL ACTION OF THE METHOD TO ACCESS
                    const apiUrl2 = `@Url.Action("LoadNewBatteryData", "Home")/${batteryNumber}/update`;
                    // Get the information of the selected item from the controller
                    const Data2 = await fetch(apiUrl2);
                    if (Data2.status === 200) //status success
                    {
                        const result2 = await Data2.json();
                        if (timeData.at(-1) != result2.timeData) {
                            batteryVoltage.shift(); //remove the first element of the voltage data
                            timeData.shift(); //remove the first element of the time data

                            //insert the fetch data to the last element
                            batteryVoltage.push(result2.voltage);
                            timeData.push(result2.timeData)
                        }

                    }
                    else {
                        toastr.error("Fetch data error");
                    }
                }

                // get new data every updateTime(as set above) and update chart
                setInterval(async function () {
                    getNewData();
                    myChart.update();
                    console.log(`New data is fetched for battery number ${batteryNumber}`);
                }, updateTime);

                //END UPDATING THE CHART --------------------------------------------------------------------------------------------------
            });
        </script>
    }

    @*FOR BATTERY TEMPERATURE*@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />

    <title>SolarManagement | @ViewData["Title"]</title>
    <partial name="AdminLTE/_Styles" />
    <link rel="icon" type="image/jpg" href="~/img/logo.png">
    @RenderSection("Styles", required: false)


</head>
<body class="layout-top-nav">
    <div class="wrapper">
        @*<partial name="AdminLTE/_PreLoader" />*@
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                @*                <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>*@
                    <li class="nav-item d-none d-sm-inline-block">
                        <a href="@Url.Action("Index", "Home")" class="nav-link">Monitoring</a>
                    </li>
            </ul>
        </nav>
        <div class="content-wrapper">
            <div class="content-header" id="contentHeader" name="contentHeader">
            </div>
            <div class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>
        <aside class="control-sidebar control-sidebar-dark">
            <div class="p-3">
                <h5>Title</h5>
                <p>Sidebar content</p>
            </div>
        </aside>
        <partial name="AdminLTE/_Footer" />
    </div>
    <partial name="AdminLTE/_Scripts" />
    @RenderSection("Scripts", required: false)
</body>
</html>
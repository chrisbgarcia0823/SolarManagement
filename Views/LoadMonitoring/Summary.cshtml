﻿@{
    ViewData["Title"] = "Critical Load Monitoring";
    ViewData["ContentHeader"] = "Load Monitoring Summary";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@section Styles
    {
    @*FOR ALERTS*@
    <link href="~/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/plugins/toastr/toastr.min.css" rel="stylesheet" />
}

@*FOR THE OUTPUT LOAD POWER*@
<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title"><i class="far fa-chart-bar"></i> Output Power Monitoring</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart" id="PowerDiv">
            <canvas id="BarChart-Power" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
        </div>
    </div>
</div>

@*FOR THE OUTPUT LOAD VOLTAGE*@
<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title"><i class="far fa-chart-bar"></i> Output Voltage Monitoring</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart" id="VoltageDiv">
            <canvas id="BarChart-Voltage" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
        </div>
    </div>
</div>

@*FOR THE OUTPUT LOAD CURRENT*@
<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title"><i class="far fa-chart-bar"></i> Output Current Monitoring</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart" id="CurrentDiv">
            <canvas id="BarChart-Ampere" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
        </div>
    </div>
</div>

@section Scripts
{

    @*FOR ALERTS*@
    <script src="~/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/plugins/toastr/toastr.min.js"></script>

    @*FOR CHART JS*@
    <script src="~/plugins/chart.js/Chart.min.js"></script>

    @*FOR BARCHART POWER*@
    <script>
        $(async function () {

            //FOR ALERT
            var Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000
            });

            //FOR OUTPUT POWER MONITORING VARIABLES---------------------------------------------------------------------------------
            let loadVolt = [];
            let loadPower = [];
            let loadAmpere = [];
            let espNumber = [];
            let loadDate = [];
            let currentTime = []; //convert to current date and get time
            let updateTime = 60 * 1000; //1seconds
            let isRealTime = false;
            let modalCloseBtn = document.getElementById('ModalCloseBtn')

            const apiUrl = `@Url.Action("GetLoadData", "power")`;
            const Data = await fetch(apiUrl);
            if (Data.status === 200) //status success
            {
                const result = await Data.json();
                //iterate to get the result
                for (i = 0; i < result.length; i++) {
                    loadVolt.push(result[i].volt);
                    loadAmpere.push(result[i].ampere);
                    currentTime.push(result[i].timeData.toString());
                    espNumber.push(result[i].espNum);
                    loadPower.push(result[i].power);
                };
            }
            else {
                toastr.error("Error fetching output load data");
            }
            //END FOR OUTPUT POWER MONITORING VARIABLES---------------------------------------------------------------------------------


            //FOR THE INPUT POWER MONITORING VARIABLES---------------------------------------------------------------------------------
            let loadVolt_Input = [];
            let loadPower_Input = [];
            let loadAmpere_Input = [];
            let espNumber_Input = [];

            const apiUrl_Input = `@Url.Action("GetLoadDataInput", "power")`;
            const Data_Input = await fetch(apiUrl_Input);
            if (Data_Input.status === 200) //status success
            {
                const result_Input = await Data_Input.json();
                //iterate to get the result
                for (i = 0; i < result_Input.length; i++) {
                    loadVolt_Input.push(result_Input[i].volt);
                    loadAmpere_Input.push(result_Input[i].ampere);
                    espNumber_Input.push(result_Input[i].espNum);
                    loadPower_Input.push(result_Input[i].power);
                };
            }
            else {
                toastr.error("Error fetching input load data");
            }
            //END FOR THE INPUT POWER MONITORING ---------------------------------------------------------------------------------


            //-------------
            //- BAR CHART - POWER DATA -------------------------------------------------------------------
            //-------------


            // Get context with jQuery - using jQuery's .get() method.
            var barChartCanvas_Power = $('#BarChart-Power').get(0).getContext('2d'); //this will be my chart

            const ChartData_Power = {
                labels: espNumber,
                datasets: [
                    {
                        label: 'Input Load Power',
                        data: loadPower_Input,
                        backgroundColor: 'rgba(51, 51, 225, 0.5)',
                    },
                    {
                        label: 'Output Load Power',
                        data: loadPower,
                        backgroundColor: 'rgba(246, 114, 128, 0.5)',
                    }
                ]
            };

            var ChartOptions_Power = {
                responsive: true,
                maintainAspectRatio: false,
                datasetFill: false,
                scales: {
                    xAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 3
                        },
                        display: true,
                        scaleLabel: {
                            display: true,
                            labelString: 'ESP Number',
                        },
                    }],
                    yAxes: [{
                        ticks: {
                            beginAtZero: true,
                        },
                        display: true,
                        scaleLabel:
                        {
                            display: true,
                            labelString: 'Watts',
                        },
                    }]
                },
            }

            const myChart_Power = new Chart(barChartCanvas_Power,
                {
                    type: 'bar',
                    data: ChartData_Power,
                    options: ChartOptions_Power
                })


            //-------------
            //- BAR CHART - VOLTAGE DATA -------------------------------------------------------------------------
            //-------------
            
            // Get context with jQuery - using jQuery's .get() method.
            var barChartCanvas_Voltage = $('#BarChart-Voltage').get(0).getContext('2d'); //this will be my chart

            const ChartData_Voltage = {
                labels: espNumber,
                datasets: [
                    {
                        label: 'Input Load Voltage',
                        data: loadVolt_Input,
                        backgroundColor: 'rgba(51, 51, 225, 0.5)',
                    },
                    {
                        label: 'Output Load Voltage',
                        data: loadVolt,
                        backgroundColor: 'rgba(246, 114, 128, 0.5)',
                    }
                ]
            };

            var ChartOptions_Voltage = {
                responsive: true,
                maintainAspectRatio: false,
                datasetFill: false,
                scales: {
                    xAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 3
                        },
                        display: true,
                        scaleLabel: {
                            display: true,
                            labelString: 'ESP Number',
                        },
                    }],
                    yAxes: [{
                        ticks: {
                            beginAtZero: true,
                        },
                        display: true,
                        scaleLabel:
                        {
                            display: true,
                            labelString: 'Volts',
                        },
                    }]
                },
            }

            const myChart_Voltage = new Chart(barChartCanvas_Voltage,
                {
                    type: 'bar',
                    data: ChartData_Voltage,
                    options: ChartOptions_Voltage
                })


            //-------------
            //- BAR CHART - AMPERE DATA -------------------------------------------------------------------------
            //-------------

            // Get context with jQuery - using jQuery's .get() method.
            var barChartCanvas_Ampere = $('#BarChart-Ampere').get(0).getContext('2d'); //this will be my chart

            const ChartData_Ampere = {
                labels: espNumber,
                datasets: [
                    {
                        label: 'Input Load Current',
                        data: loadAmpere_Input,
                        backgroundColor: 'rgba(51, 51, 225, 0.5)',
                    },
                    {
                        label: 'Output Load Current',
                        data: loadAmpere,
                        backgroundColor: 'rgba(246, 114, 128, 0.5)',
                    }
                ]
            };

            var ChartOptions_Ampere = {
                responsive: true,
                maintainAspectRatio: false,
                datasetFill: false,
                scales: {
                    xAxes: [{
                        ticks: {
                            beginAtZero: true,
                            max: 3
                        },
                        display: true,
                        scaleLabel: {
                            display: true,
                            labelString: 'ESP Number',
                        },
                    }],
                    yAxes: [{
                        ticks: {
                            beginAtZero: true,
                        },
                        display: true,
                        scaleLabel:
                        {
                            display: true,
                            labelString: 'Ampere',
                        },
                    }]
                },
            }

            const myChart_Ampere = new Chart(barChartCanvas_Ampere,
                {
                    type: 'bar',
                    data: ChartData_Ampere,
                    options: ChartOptions_Ampere
                })

            //GET NEW DATA ---------------------------------------------------------------------------------------

            async function getNewData() 
            {
                //CLEAR PREVIOUS VALUES 
                //for output load values ----------------------------------------------------------------
                loadVolt = [];
                loadPower = [];
                loadAmpere = [];
                espNumber = [];
                loadDate = [];
                currentTime = []


                //URL ACTION OF THE METHOD TO ACCESS
                const apiUrl_Update = `@Url.Action("GetLoadData", "power")`;
                // Get the information of the selected item from the controller
                const Data_Update = await fetch(apiUrl_Update);
                if (Data_Update.status === 200) //status success
                {
                    const result_Update = await Data_Update.json();
                    //iterate to get the result
                    for (i = 0; i < result_Update.length; i++) {
                        loadVolt.push(result_Update[i].volt);
                        loadAmpere.push(result_Update[i].ampere);
                        currentTime.push(result_Update[i].timeData.toString());
                        espNumber.push(result_Update[i].espNum);
                        loadPower.push(result_Update[i].power);
                    };

                }
                else 
                {
                    toastr.error("Error fectching input load update data");
                }
                //end for output load values -------------------------------------------------------------

                //for output load values -----------------------------------------------------------------
                let loadVolt_Input = [];
                let loadPower_Input = [];
                let loadAmpere_Input = [];
                let espNumber_Input = [];

                //URL ACTION OF THE METHOD TO ACCESS
                const apiUrl_Update_Input = `@Url.Action("GetLoadDataInput", "power")`;
                // Get the information of the selected item from the controller
                const Data_Update_Input = await fetch(apiUrl_Update_Input);
                if (Data_Update_Input.status === 200) //status success
                {
                    const result_Update_Input = await Data_Update_Input.json();
                    //iterate to get the result
                    for (i = 0; i < result_Update_Input.length; i++) {
                        loadVolt_Input.push(result_Update_Input[i].volt);
                        loadAmpere_Input.push(result_Update_Input[i].ampere);
                        espNumber_Input.push(result_Update_Input[i].espNum);
                        loadPower_Input.push(result_Update_Input[i].power);
                    };

                }
                else {
                    toastr.error("Error fectching input load update data");
                }
                //end for output load values -------------------------------------------------------------
            }

            // get new data every updateTime(as set above) and update chart
            setInterval(async function () {

                //get new data using api
                await getNewData();

                //update the chart output load data ----------------------
                myChart_Power.data.datasets[0].data = loadPower;
                myChart_Voltage.data.datasets[0].data = loadVolt;
                myChart_Ampere.data.datasets[0].data = loadAmpere;

                //update the chart input load data ----------------------
                myChart_Power.data.datasets[1].data = loadPower_Input;
                myChart_Voltage.data.datasets[1].data = loadVolt_Input;
                myChart_Ampere.data.datasets[1].data = loadAmpere_Input;

                //update the chart
                myChart_Power.update();
                myChart_Voltage.update()
                myChart_Ampere.update()

                //myChart_Temperature.update();
                console.log('Power Bar Chart Data Updated');
            }, updateTime);


            //END UPDATING THE CHART --------------------------------------------------------------------------------------------------


            //FOR CLICK AND OPEN MODAL ---------------------------------------------------------------------------------------------------------------
            //for modal


            // Event listener for chart click events for voltage
            barChartCanvas_Power.canvas.addEventListener('click', async (event) => {
                const clickedElements = myChart_Power.getElementsAtEvent(event);
                if (clickedElements.length > 0) {
                    const element = clickedElements[0]; // Get the first clicked element
                    const labelIndex = element._index; // Index of the clicked bar
                    const espNum = loadVolt[labelIndex];

                    //window.location.href = `@Url.Action("LiveData")/${batteryNum}/Voltage`;
                }
            });

            // Event listener for chart click events for temperature
            //barChartCanvas_Temperature.canvas.addEventListener('click', async (event) => {
            //    const clickedElements = myChart_Temperature.getElementsAtEvent(event);
            //    if (clickedElements.length > 0) {
            //        const element = clickedElements[0]; // Get the first clicked element
            //        const labelIndex = element._index; // Index of the clicked bar
            //        const batteryNum = batterNumber[labelIndex];

            //        window.location.href = `@Url.Action("LiveData")/${batteryNum}/Temperature`;
            //    }
            //});

            //END OF BATTERY VOLTAGES AND CURRENT MONITORING -------------------------------------------------------------------------------

        });
    </script>

}